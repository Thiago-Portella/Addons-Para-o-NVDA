#: __init__.py:84
msgid "xPand - AutoCorrect"
msgstr "xPand - ແກ້ໄຂອັດຕະໂນມັດ"

#: __init__.py:97 __init__.py:263
msgid "Code:"
msgstr "ລະຫັດ:"

