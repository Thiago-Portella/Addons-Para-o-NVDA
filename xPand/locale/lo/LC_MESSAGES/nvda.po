#: __init__.py:253
msgid "Code"
msgstr "ລະຫັດ"

#: __init__.py:254
msgid "Word"
msgstr "ຄຳສັບ"

#: __init__.py:269
msgid "Word:"
msgstr "ຄຳສັບ:"

#: __init__.py:275
msgid "Add"
